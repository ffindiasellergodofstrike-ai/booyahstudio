# Public canonical checkout/callback domain (HTTPS in production).
APP_URL=https://www.booyahstudio.shop

# Firebase Realtime Database
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_AUTH=
# Keep the existing private server-side REST credential in Vercel.
# FIREBASE_DATABASE_SECRET is supported as an alternative variable name.
# Production orders and accounts require authenticated REST access.
FIREBASE_STORAGE_BUCKET=

# Private product ZIP source. A complete MEGA file link (including its #key) or
# a direct HTTPS object-storage URL is supported. Keep it only in Vercel.
# Product id "linknest-pro" maps to PRODUCT_DOWNLOAD_URL_LINKNEST_PRO.
PRODUCT_DOWNLOAD_URL_LINKNEST_PRO=
PRODUCT_DOWNLOAD_URL_NEURA_AI=
PRODUCT_DOWNLOAD_URL_FINORA=
PRODUCT_DOWNLOAD_URL_LEARNIFY=
PRODUCT_DOWNLOAD_URL_VELORA=
PRODUCT_DOWNLOAD_URL_WORKHUB=

# Paddle Payment Gateway (Global - Card / PayPal / Apple Pay / Google Pay)
# Environment: 'sandbox' for testing, 'production' for live payments
PADDLE_ENVIRONMENT=sandbox
# Client-side token (allowed in frontend code, e.g. test_... or live_...)
PADDLE_CLIENT_TOKEN=
# Private backend API key (keep secret, never expose to frontend)
PADDLE_API_KEY=
# Paddle Webhook Secret (for Paddle-Signature verification, e.g. pdl_ntf_set_...)
PADDLE_WEBHOOK_SECRET=

# Paddle Price IDs mapping for digital catalog items:
# Create one-time products/prices in Paddle dashboard and copy Price IDs (pri_...)
PADDLE_PRICE_LINKNEST_PRO=
PADDLE_PRICE_NEURA_AI=
PADDLE_PRICE_FINORA=
PADDLE_PRICE_LEARNIFY=
PADDLE_PRICE_VELORA=
PADDLE_PRICE_WORKHUB=

# Easebuzz Payment Gateway (India)
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test # test | prod

# Cron / Reconcile Secret
CRON_SECRET=

# Resend purchase confirmation email. The sender must belong to a domain that
# is verified in Resend. Keep the API key only in Vercel environment variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL="BOOYAH STUDIO <orders@booyahstudio.shop>"

# One-time email download links expire after this many hours (1-720).
PURCHASE_EMAIL_LINK_TTL_HOURS=168

# Details printed on the attached PDF invoice.
INVOICE_BUSINESS_NAME="BOOYAH STUDIO"
INVOICE_BUSINESS_ADDRESS="House No. 12, Thakur Niwas, C Block, Shantipuram, Phaphamau, Prayagraj, District Prayagraj, Uttar Pradesh 211013, India"
INVOICE_GSTIN=
INVOICE_SUPPORT_EMAIL="connectbooyahstudio@gmail.com"

# PayU Hosted Checkout: test by default. Use separate live merchant credentials.
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test

# Original collection: upload each private ZIP, then set its HTTPS source URL.
PRODUCT_DOWNLOAD_URL_MARGIN_PORTFOLIO=
PRODUCT_DOWNLOAD_URL_CLAY_SHELF=
PRODUCT_DOWNLOAD_URL_LINE_AND_SPACE=
PRODUCT_DOWNLOAD_URL_FIRST_LIGHT=
PRODUCT_DOWNLOAD_URL_LESSON_PATH=
PRODUCT_DOWNLOAD_URL_ORBIT_BOARD=
PRODUCT_DOWNLOAD_URL_CLEAR_QUOTE=
PRODUCT_DOWNLOAD_URL_POCKET_PAGE=
PRODUCT_DOWNLOAD_URL_GATHER_AGENDA=
PRODUCT_DOWNLOAD_URL_LEAF_COUNTER=
PRODUCT_DOWNLOAD_URL_TABLE_NOTES=
PRODUCT_DOWNLOAD_URL_FRAME_STUDY=
PRODUCT_DOWNLOAD_URL_FIELD_JOURNAL=
PRODUCT_DOWNLOAD_URL_SCOPE_STUDIO=
PRODUCT_DOWNLOAD_URL_ROOM_PALETTE=
PRODUCT_DOWNLOAD_URL_AUDIO_NOTEBOOK=
PRODUCT_DOWNLOAD_URL_COMMON_CALENDAR=
PRODUCT_DOWNLOAD_URL_FOCUS_WEEK=
PRODUCT_DOWNLOAD_URL_PLAIN_HANDBOOK=
PRODUCT_DOWNLOAD_URL_SIGNAL_DECK=
