# CLIENT VARIABLES: none required. Never prefix server secrets with VITE_.
# RAZORPAY_KEY_ID is returned to checkout; SUPABASE_ANON_KEY is used by server Auth.
# SERVER CONFIGURATION: set in Vercel Project Settings > Environment Variables.
# No server secret may use a VITE_ prefix. Apply in Vercel and redeploy.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
# Replace with an address on your verified sending domain (not an unverified Gmail sender).
RESEND_FROM_EMAIL=

# Cashfree is preferred when configured. Keep sandbox and production credentials separate.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
# Optional signed Resend delivery/bounce webhook verification secret.
RESEND_WEBHOOK_SECRET=
# Protects /api/jobs/reconcile. Configure a scheduler every 5 minutes if supported.
CRON_SECRET=
